---
import AccuracyPanel from '../islands/AccuracyPanel';
import HeavyHitters from '../islands/HeavyHitters';
import Kpis from '../islands/Kpis';
import ReleasePanel from '../islands/ReleasePanel';
import WidthPanel from '../islands/WidthPanel';
import Dashboard from '../layouts/Dashboard.astro';
---

<Dashboard
  view="overview"
  title="Every event counts."
  subtitle="Frequency analytics that adapt to change, with privacy in the loop."
>
  <Kpis client:load />
  <div class="charts-row">
    <AccuracyPanel client:load />
    <ReleasePanel client:load />
  </div>
  <div class="secondary-row">
    <WidthPanel client:visible />
    <HeavyHitters client:visible />
  </div>
</Dashboard>
